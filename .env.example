# Copy this file to .env and fill in the values. .env is git-ignored and must
# never be committed. This file holds placeholders only.

# Google Gemini API key. Free tier, no card required.
# Get one at https://aistudio.google.com  ->  Get API key
#
# Only needed for live calls. With a populated fixtures/llm_cache/ the
# pipelines, the evaluation harness and both interfaces run fully offline
# without a key.
GEMINI_API_KEY=

# Model. A flash model is used because this workload is high volume and
# latency sensitive rather than reasoning heavy, and it sits inside the free
# tier. Verified against the models the API actually offers on startup.
GEMINI_MODEL=gemini-3.5-flash-lite

# Determinism controls. Task 2 requires identical output for identical input.
# Temperature zero and a fixed seed make generation repeatable at the provider;
# the response cache guarantees it regardless.
LLM_TEMPERATURE=0.0
LLM_SEED=42

# Generation limits.
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60

# Cost and reproducibility controls.
#   LLM_CACHE=off      bypass cache reads (writes still happen) to regenerate
#   LLM_OFFLINE=1      never call the API; fail instead of spending quota
#   LLM_MAX_CALLS      hard cap on live calls per process (cache hits are free)
LLM_CACHE=on
LLM_OFFLINE=0
LLM_MAX_CALLS=60
