# Copy this file to .env and fill in the values. .env is git-ignored.

# Anthropic API key - https://console.anthropic.com/settings/keys
# Only needed for live calls. With a populated fixtures/llm_cache/ the
# pipelines and the eval harness run fully offline, without a key.
ANTHROPIC_API_KEY=sk-ant-...

# Model and sampling. Temperature is 0.0 because Task 2 requires deterministic
# output for the same input.
ANTHROPIC_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60

# Cost and reproducibility controls.
#   LLM_CACHE=off      bypass cache reads (writes still happen) to regenerate
#   LLM_OFFLINE=1      never call the API; fail instead of spending
#   LLM_MAX_CALLS      hard cap on live calls per process (cache hits are free)
LLM_CACHE=on
LLM_OFFLINE=0
LLM_MAX_CALLS=60
